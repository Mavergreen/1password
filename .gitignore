docs/
*.pkg
.*.swp
# CMake/build OUTPUT dirs only -- NOT build/ (that holds the committed version wrappers).
/_build/
build-*/

# Claude Code scratch dir (CLAUDE_CODE_TMPDIR)
.tmp-claude/

# macOS cruft (baseline parity with the other mavericks-* repos)
._*
.DS_Store

# Full version (<version>-mavericks.N): a build product, stamped at release. UPSTREAM_VERSION is committed.
/VERSION
# Default build root is $MAVERICKS_BUILD_ROOT (outside the tree); this is only the deliberate-in-tree
# escape hatch (MAVERICKS_BUILD_ROOT="$PWD" sh packaging/macos/build_pkg.sh ...).
/onep-build/
