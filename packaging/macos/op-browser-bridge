#!/bin/sh
# platform: macOS-only -- Momiji and PowerFox run it as the 1Password extension's native-messaging host
# The package's NativeMessagingHosts manifest names this file. Browsers start it with a bare PATH, so
# it names the installed Porthole's porthole-native-host, which runs the 1password preset's browser host.
exec "${PORTHOLE_ENGINE_BIN:-/Applications/Porthole.app/Contents/Resources/engine/bin}/porthole-native-host" 1password browser "$@"
