#!/bin/sh
# Materialize "Linux 1Password.app" from the preset conf. Runs as root at install time with no Docker,
# so --no-icon builds the .app structure now (generic icon); the container image + real 1Password icon
# resolve on first launch, as the user.
set -eu
CONF="/Library/Application Support/Mavergreen/Porthole/presets/1password.conf"
sh "$(dirname "$0")/flag-day-migration" "$@" || true   # ONE-TIME MIGRATION; DELETABLE with that script
PORTHOLE=/usr/local/bin/porthole
[ -x "$PORTHOLE" ] || PORTHOLE="/Applications/Porthole.app/Contents/Resources/engine/bin/porthole"
PORTHOLE_MATERIALIZE_NO_ICON=1 "$PORTHOLE" materialize "$CONF" --apps-dir /Applications
exit 0
