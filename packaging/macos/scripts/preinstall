#!/bin/sh
# The 1Password preset needs Porthole (materializes + runs the viewer) AND Docker for Mavericks (the
# container backend). The installer runs scripts as root (PATH may omit /usr/local/bin), so check both.
if [ ! -x /usr/local/bin/porthole ] && [ ! -d /Applications/Porthole.app ]; then
  echo "mavericks-1password needs Porthole installed first (it provides the viewer engine)." >&2
  echo "Install Porthole (https://github.com/Mavergreen/porthole), then run this installer again." >&2
  exit 1
fi
if ! command -v docker-machine >/dev/null 2>&1 && [ ! -x /usr/local/bin/docker-machine ]; then
  echo "mavericks-1password needs Docker for Mavericks (docker-machine) installed first." >&2
  echo "Install it (see the project README), then run this installer again." >&2
  exit 1
fi
exit 0
