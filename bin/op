#!/bin/sh
# platform: macOS-only -- runs the installed Porthole.app's engine
# op -- 1Password's own CLI, run in Linux 1Password's container as a native op talks to its running
# app: Porthole's porthole-cli, from the 1password preset's CLI declaration.
exec "${PORTHOLE_ENGINE_BIN:-/Applications/Porthole.app/Contents/Resources/engine/bin}/porthole-cli" 1password op "$@"
